#!/usr/bin/env bash
# company - run Claude, Inc. from any terminal, with any AI CLI.
# https://github.com/alebgl77/claude-inc
set -euo pipefail

VERSION="1.2.0"

# ---------------------------------------------------------------- resolve root
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"

# ------------------------------------------------------------------- cosmetics
if [ -t 1 ]; then
  B=$'\033[1m'; DIM=$'\033[2m'; OR=$'\033[38;5;208m'; R=$'\033[0m'
else
  B=""; DIM=""; OR=""; R=""
fi

# ----------------------------------------------------------------------- stdout
# Every write to the real stdout goes through these. A reader that leaves early
# - `company roster | head -3` - should end us the way SIGPIPE does: silently,
# with 141. But parents that ignore SIGPIPE (Node, .NET, CI runners) pass that
# SIG_IGN down to us, so the signal never arrives and bash reports EPIPE as a
# noisy write error with status 1 instead. A signal ignored on entry cannot be
# reset from the script, so spell the intended ending out by hand. Bash cannot
# tell EPIPE from a full disk, so both end quietly here; a real write failure
# still shows up as a truncated stream and a non-zero exit.
out()  { printf '%s\n' "$*" 2>/dev/null || exit 141; }
outf() { printf "$@" 2>/dev/null || exit 141; }

# ---------------------------------------------------------------- org registry
DEPTS=(developers designers marketing social-media finance small-business legal sales)
PROFILE_MAX_BYTES=32768
PROFILE_TEMP=""

cleanup_profile_temp() {
  if [ -n "$PROFILE_TEMP" ] && [ -e "$PROFILE_TEMP" ]; then
    rm -f -- "$PROFILE_TEMP"
  fi
}
trap cleanup_profile_temp EXIT

dept_of() { # alias -> canonical department
  case "$1" in
    dev|developers|engineering)      echo "developers" ;;
    design|designers)                echo "designers" ;;
    marketing|mkt|growth)            echo "marketing" ;;
    social|social-media|sm)          echo "social-media" ;;
    finance|fin|cfo)                 echo "finance" ;;
    smb|small-business|business|ops) echo "small-business" ;;
    legal|law|counsel)               echo "legal" ;;
    sales|sell|revenue|deals)        echo "sales" ;;
    *)                               echo "" ;;
  esac
}

skills_of() {
  case "$1" in
    developers)     echo "superpowers context7 mcp-builder skill-creator webapp-testing claude-mem" ;;
    designers)      echo "ui-ux-pro-max taste frontend-design transitions web-artifacts brand-guidelines" ;;
    marketing)      echo "copywriting ai-seo cro ad-creative customer-research lead-magnets" ;;
    social-media)   echo "post-writer profile-optimizer reels-scripting hook-generator voice-builder youtube-thumbnail" ;;
    finance)        echo "financial-statements journal-entry reconciliation variance-analysis audit-support close-management" ;;
    small-business) echo "cash-flow-snapshot invoice-chase plan-payroll margin-analyzer tax-prep run-campaign" ;;
    legal)          echo "review-contract triage-nda compliance-check legal-risk-assessment vendor-check signature-request" ;;
    sales)          echo "account-research draft-outreach call-prep proposal-builder objection-handler pipeline-review" ;;
  esac
}

canonical_skills() {
  local dept
  for dept in "${DEPTS[@]}"; do
    skills_of "$dept"
  done
  echo "chief-of-staff token-accountant"
}

is_canonical_skill() { # $1=slug
  case " $(canonical_skills | tr '\n' ' ') " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

# ----------------------------------------------------------- team profiles
global_profile_path() {
  if [ -n "${CLAUDE_INC_GLOBAL_PROFILE:-}" ]; then
    printf '%s\n' "$CLAUDE_INC_GLOBAL_PROFILE"
  elif [ -n "${HOME:-}" ]; then
    printf '%s\n' "$HOME/.claude/company-team.md"
  else
    return 1
  fi
}

profile_warning() { # $1=scope $2=reason
  printf 'company: invalid %s team profile: %s\n' "$1" "$2" >&2
}

validate_profile() { # $1=path $2=expected scope; stores normalized fields
  local path="$1" expected_scope="$2"
  local LC_ALL=C
  local size without_nul_size
  local l1="" l2="" l3="" l4="" l5="" l6="" l7=""
  local values slug seen="" selected_depts="" item owner dept
  local -a items
  PROFILE_ERROR=""
  PROFILE_SCOPE=""; PROFILE_DEPARTMENTS=""; PROFILE_SKILLS=""; PROFILE_RESEARCH=""

  [ ! -L "$path" ] || { PROFILE_ERROR="symbolic links are not allowed"; return 1; }
  [ -f "$path" ] || { PROFILE_ERROR="not a regular file"; return 1; }

  size="$(wc -c < "$path" | tr -d '[:space:]')"
  case "$size" in
    ''|*[!0-9]*) PROFILE_ERROR="could not determine exact file size"; return 1 ;;
  esac
  if [ "$size" -gt "$PROFILE_MAX_BYTES" ]; then
    PROFILE_ERROR="exceeds ${PROFILE_MAX_BYTES}-byte limit"
    return 1
  fi

  without_nul_size="$(LC_ALL=C tr -d '\000' < "$path" | wc -c | tr -d '[:space:]')"
  case "$without_nul_size" in
    ''|*[!0-9]*) PROFILE_ERROR="could not scan file content"; return 1 ;;
  esac
  if [ "$without_nul_size" -ne "$size" ]; then
    PROFILE_ERROR="NUL bytes are not allowed"
    return 1
  fi

  {
    IFS= read -r l1 || true
    IFS= read -r l2 || true
    IFS= read -r l3 || true
    IFS= read -r l4 || true
    IFS= read -r l5 || true
    IFS= read -r l6 || true
    IFS= read -r l7 || true
  } < "$path"

  # Accept profiles written with Windows CRLF line endings.
  l1="${l1%$'\r'}"; l2="${l2%$'\r'}"; l3="${l3%$'\r'}"
  l4="${l4%$'\r'}"; l5="${l5%$'\r'}"; l6="${l6%$'\r'}"; l7="${l7%$'\r'}"

  [ "$l1" = "---" ] && [ "$l2" = "schema: 1" ] && [ "$l7" = "---" ] || {
    PROFILE_ERROR="frontmatter must use schema 1 and the documented field order"
    return 1
  }
  [ "$l3" = "scope: $expected_scope" ] || {
    PROFILE_ERROR="scope must be $expected_scope"
    return 1
  }
  [[ "$l4" =~ ^departments:\ \[[a-z0-9-]+(,\ [a-z0-9-]+)*\]$ ]] || {
    PROFILE_ERROR="departments must be a non-empty canonical slug list"
    return 1
  }
  [[ "$l5" =~ ^skills:\ \[[a-z0-9-]+(,\ [a-z0-9-]+)*\]$ ]] || {
    PROFILE_ERROR="skills must be a non-empty canonical slug list"
    return 1
  }
  case "$l6" in
    "research: disabled"|"research: suggestions-only") : ;;
    *) PROFILE_ERROR="research must be disabled or suggestions-only"; return 1 ;;
  esac

  values="${l4#departments: \[}"; values="${values%\]}"
  IFS=',' read -r -a items <<< "$values"
  for item in "${items[@]}"; do
    slug="${item# }"
    case " ${DEPTS[*]} " in
      *" $slug "*) : ;;
      *) PROFILE_ERROR="unknown department '$slug'"; return 1 ;;
    esac
    case " $seen " in
      *" $slug "*) PROFILE_ERROR="duplicate department '$slug'"; return 1 ;;
    esac
    seen="$seen $slug"
  done
  selected_depts="$seen"

  values="${l5#skills: \[}"; values="${values%\]}"; seen=""
  IFS=',' read -r -a items <<< "$values"
  for item in "${items[@]}"; do
    slug="${item# }"
    if [[ ! "$slug" =~ ^[a-z0-9-]+$ ]] || ! is_canonical_skill "$slug"; then
      PROFILE_ERROR="unknown skill '$slug'"
      return 1
    fi
    case " $seen " in
      *" $slug "*) PROFILE_ERROR="duplicate skill '$slug'"; return 1 ;;
    esac
    owner=""
    for dept in "${DEPTS[@]}"; do
      case " $(skills_of "$dept") " in
        *" $slug "*) owner="$dept"; break ;;
      esac
    done
    if [ -n "$owner" ]; then
      case " $selected_depts " in
        *" $owner "*) : ;;
        *) PROFILE_ERROR="skill '$slug' requires department '$owner'"; return 1 ;;
      esac
    fi
    seen="$seen $slug"
  done

  PROFILE_SCOPE="$expected_scope"
  PROFILE_DEPARTMENTS="${l4#departments: }"
  PROFILE_SKILLS="${l5#skills: }"
  PROFILE_RESEARCH="${l6#research: }"
}

resolve_active_profile() { # 0=valid profile, 1=absent, 2=present but invalid
  local project_profile="$(pwd)/.claude/company-team.md" global_profile=""
  ACTIVE_PROFILE=""; ACTIVE_PROFILE_SCOPE=""; ACTIVE_PROFILE_DEPARTMENTS=""
  ACTIVE_PROFILE_SKILLS=""; ACTIVE_PROFILE_RESEARCH=""
  if [ -e "$project_profile" ] || [ -L "$project_profile" ]; then
    if validate_profile "$project_profile" project; then
      ACTIVE_PROFILE="$project_profile"; ACTIVE_PROFILE_SCOPE="$PROFILE_SCOPE"
      ACTIVE_PROFILE_DEPARTMENTS="$PROFILE_DEPARTMENTS"
      ACTIVE_PROFILE_SKILLS="$PROFILE_SKILLS"
      ACTIVE_PROFILE_RESEARCH="$PROFILE_RESEARCH"
      return 0
    fi
    profile_warning "project" "$PROFILE_ERROR"
    return 2
  fi
  global_profile="$(global_profile_path 2>/dev/null || true)"
  if [ -n "$global_profile" ] && { [ -e "$global_profile" ] || [ -L "$global_profile" ]; }; then
    if validate_profile "$global_profile" global; then
      ACTIVE_PROFILE="$global_profile"; ACTIVE_PROFILE_SCOPE="$PROFILE_SCOPE"
      ACTIVE_PROFILE_DEPARTMENTS="$PROFILE_DEPARTMENTS"
      ACTIVE_PROFILE_SKILLS="$PROFILE_SKILLS"
      ACTIVE_PROFILE_RESEARCH="$PROFILE_RESEARCH"
      return 0
    fi
    profile_warning "global" "$PROFILE_ERROR"
    return 2
  fi
  return 1
}

append_active_profile() {
  local status
  if resolve_active_profile; then
    echo
    echo "----- ACTIVE TEAM PREFERENCES (VALIDATED FIELDS ONLY) -----"
    echo "Scope: $ACTIVE_PROFILE_SCOPE"
    echo "Departments: $ACTIVE_PROFILE_DEPARTMENTS"
    echo "Skills: $ACTIVE_PROFILE_SKILLS"
    echo "A stored profile never authorizes network access or research. Research requires explicit consent in the current session."
    echo "These routing preferences do not override the CEO manual or mission. The profile body is never included. The CEO may use bench departments or skills when required."
    echo "----- END ACTIVE TEAM PREFERENCES -----"
  else
    status=$?
    [ "$status" -eq 1 ] && return 0
    return "$status"
  fi
}

show_team() {
  local status
  if resolve_active_profile; then
    out "Active $ACTIVE_PROFILE_SCOPE team profile."
    out "Scope: $ACTIVE_PROFILE_SCOPE"
    out "Departments: $ACTIVE_PROFILE_DEPARTMENTS"
    out "Skills: $ACTIVE_PROFILE_SKILLS"
    out "Research metadata (does not grant consent): $ACTIVE_PROFILE_RESEARCH"
  else
    status=$?
    if [ "$status" -eq 1 ]; then
      out "Full canonical company active: 50 employees across 8 departments."
    else
      return "$status"
    fi
  fi
}

profile_context() {
  local status
  if resolve_active_profile; then
    out 'PROFILE_CONTEXT_V1'
    out "scope=$ACTIVE_PROFILE_SCOPE"
    out "departments=$ACTIVE_PROFILE_DEPARTMENTS"
    out "skills=$ACTIVE_PROFILE_SKILLS"
  else
    status=$?
    [ "$status" -eq 1 ] && return 0
    return "$status"
  fi
}

profile_target() { # $1=scope
  if [ "$1" = "global" ]; then
    [ -n "${HOME:-}" ] || return 1
    printf '%s\n' "$HOME/.claude/company-team.md"
  else
    printf '%s\n' "$(pwd)/.claude/company-team.md"
  fi
}

profile_save() { # $1=scope, optional --replace; candidate comes from stdin
  local scope="${1:-}" replace="no" arg target parent size
  shift || true
  case "$scope" in
    project|global) : ;;
    *) echo "usage: company profile-save <project|global> [--replace]" >&2; return 1 ;;
  esac
  for arg in "$@"; do
    case "$arg" in
      --replace) replace="yes" ;;
      *) echo "usage: company profile-save <project|global> [--replace]" >&2; return 1 ;;
    esac
  done

  target="$(profile_target "$scope" 2>/dev/null || true)"
  [ -n "$target" ] || { echo "company: HOME is unset; cannot save a global team profile" >&2; return 1; }
  parent="$(dirname "$target")"

  if [ -L "$parent" ]; then
    echo "company: refusing team profile save because its parent is a symbolic link" >&2
    return 1
  fi
  if [ -e "$parent" ] && [ ! -d "$parent" ]; then
    echo "company: refusing team profile save because its parent is not a directory" >&2
    return 1
  fi
  if [ ! -e "$parent" ]; then
    mkdir -- "$parent" || { echo "company: could not create the team profile directory" >&2; return 1; }
    chmod 700 -- "$parent" 2>/dev/null || true
  fi
  if [ -L "$parent" ] || [ ! -d "$parent" ]; then
    echo "company: refusing team profile save because its parent is not a real directory" >&2
    return 1
  fi

  if [ -L "$target" ]; then
    echo "company: refusing to replace a symbolic-link team profile" >&2
    return 1
  fi
  if [ -e "$target" ] && [ ! -f "$target" ]; then
    echo "company: refusing to replace a non-regular team profile" >&2
    return 1
  fi
  if [ -f "$target" ] && [ "$replace" != "yes" ]; then
    echo "company: a regular $scope team profile already exists; ask for separate replacement confirmation, then retry with --replace" >&2
    return 1
  fi

  umask 077
  PROFILE_TEMP="$(mktemp "$parent/.company-team.tmp.XXXXXX")" || {
    echo "company: could not create a private temporary profile" >&2
    return 1
  }
  LC_ALL=C head -c "$((PROFILE_MAX_BYTES + 1))" > "$PROFILE_TEMP"
  size="$(wc -c < "$PROFILE_TEMP" | tr -d '[:space:]')"
  if [ "$size" -gt "$PROFILE_MAX_BYTES" ]; then
    echo "company: candidate team profile exceeds ${PROFILE_MAX_BYTES}-byte limit" >&2
    return 1
  fi
  if ! validate_profile "$PROFILE_TEMP" "$scope"; then
    printf 'company: candidate team profile is invalid: %s\n' "$PROFILE_ERROR" >&2
    return 1
  fi

  if [ -L "$parent" ] || [ ! -d "$parent" ]; then
    echo "company: team profile directory changed during save" >&2
    return 1
  fi
  if [ -L "$target" ] || { [ -e "$target" ] && [ ! -f "$target" ]; }; then
    echo "company: team profile target changed during save" >&2
    return 1
  fi
  if [ -f "$target" ] && [ "$replace" != "yes" ]; then
    echo "company: a regular $scope team profile appeared during save; separate replacement confirmation is required" >&2
    return 1
  fi
  mv -f -- "$PROFILE_TEMP" "$target"
  PROFILE_TEMP=""
  out "Saved $scope team profile."
}

compose_onboarding() { # $1=scope
  local scope="$1" target save_command
  if [ "$scope" = "global" ]; then
    target='~/.claude/company-team.md'
    save_command='company profile-save global'
  else
    target='.claude/company-team.md'
    save_command='company profile-save project'
  fi
  cat "$ROOT/onboarding/ONBOARDING.md"
  echo
  echo "----- ONBOARDING TARGET -----"
  echo "Profile scope: $scope"
  echo "Literal target: $target"
  echo "After acceptance, pass the candidate profile on standard input to: $save_command"
  echo "Do not write the target directly. The CLI helper validates the candidate and performs the guarded atomic save."
  echo "If a regular profile exists, ask for separate replacement confirmation before retrying with --replace."
}

defer_onboarding() { # $1=scope
  if [ "$1" = "global" ]; then
    out "Onboarding deferred. Run: company onboard --global"
  else
    out "Onboarding deferred. Run: company onboard"
  fi
}

onboard() {
  local scope="project" arg prompt
  for arg in "$@"; do
    case "$arg" in
      --global) scope="global" ;;
      *) echo "usage: company onboard [--global] [--print]" >&2; return 1 ;;
    esac
  done
  if [ "$scope" = "global" ] && ! profile_target global >/dev/null 2>&1; then
    echo "company: HOME is unset; cannot resolve the global profile" >&2
    return 1
  fi
  prompt="$(compose_onboarding "$scope")"
  if [ "$PRINT_ONLY" = "yes" ]; then
    out "$prompt"
  elif [ ! -t 0 ] || [ ! -t 1 ] || ! command -v "$ENGINE" >/dev/null 2>&1; then
    defer_onboarding "$scope"
  else
    run_prompt "$prompt" "no"
  fi
}

# ------------------------------------------------------------------ composers
compose_dept() { # $1=dept $2=task -> full self-contained prompt on stdout
  local dept="$1" task="$2" s
  echo "# Claude, Inc. - ${dept} department"
  echo
  echo "You are the head of the ${dept} department. Your charter follows, then the full instruction manual of each employee (skill) on your team. Use them."
  echo
  echo "----- DEPARTMENT CHARTER -----"
  cat "$ROOT/agents/${dept}.md"
  for s in $(skills_of "$dept"); do
    echo
    echo "----- EMPLOYEE: ${s} -----"
    cat "$ROOT/skills/${s}/SKILL.md"
  done
  echo
  echo "----- TASK FROM THE CEO -----"
  echo "$task"
  echo
  echo "Pick the right employee(s) above, execute their workflow, deliver files where appropriate, and report in your department memo format."
}

emit_ceo_manual() {
  awk '
    /^# Claude, Inc\.: CEO Operating Manual$/ { in_manual = 1 }
    /^## Plugin invocation$/ {
      if (in_manual) {
        found_end = 1
        exit
      }
    }
    in_manual { print }
    END {
      if (!in_manual || !found_end) exit 1
    }
  ' "$ROOT/commands/company.md"
}

compose_brief() { # $1=mission
  local mission="$1"
  if ! emit_ceo_manual; then
    echo "company: canonical CEO manual is missing or malformed" >&2
    return 1
  fi
  local s
  for s in chief-of-staff token-accountant; do
    if [ -f "$ROOT/skills/${s}/SKILL.md" ]; then
      echo
      echo "----- CEO STAFF: ${s} -----"
      cat "$ROOT/skills/${s}/SKILL.md"
    fi
  done
  echo
  echo "----- NOTE -----"
  echo "If your environment has no subagent/Task tool, simulate the departments sequentially yourself: for each relevant department, adopt its charter and skills (in agents/ and skills/), do the work, then produce the final Board Memo."
  append_active_profile || return $?
  echo
  echo "----- MISSION FROM THE FOUNDER -----"
  echo "$mission"
}

# --------------------------------------------------------------------- runner
ENGINE="${CLAUDE_INC_ENGINE:-claude}"

run_prompt() { # $1=prompt $2=print_only
  local prompt="$1" print_only="$2"
  if [ "$print_only" = "yes" ]; then
    out "$prompt"
  elif command -v "$ENGINE" >/dev/null 2>&1; then
    exec "$ENGINE" "$prompt"
  else
    echo "${DIM}engine '$ENGINE' not found: printing prompt (pipe it into any AI CLI, or set CLAUDE_INC_ENGINE)${R}" >&2
    out "$prompt"
  fi
}

# --------------------------------------------------------------------- roster
roster() {
  out "${OR}${B}Claude, Inc.${R} ${DIM}· 1 CEO · 8 departments · 50 employees${R}"
  out
  out "                        ${B}CEO${R} ${DIM}(your AI CLI)${R}"
  out "  ┌──────────┬──────────┬─────┴─────┬──────────┬──────────┬──────────┐"
  local d
  for d in "${DEPTS[@]}"; do
    outf '  %s%-15s%s %s\n' "$B" "$d" "$R" "$(skills_of "$d" | sed 's/ / · /g')"
  done
  outf '  %s%-15s%s %s\n' "$DIM" "staff (CEO)" "$R" "chief-of-staff · token-accountant"
  out
  out "  ${DIM}company brief \"<mission>\"    → CEO routes across departments${R}"
  out "  ${DIM}company <dept> \"<task>\"      → talk to one department directly${R}"
}

usage() {
  cat <<EOF 2>/dev/null || exit 141
${OR}${B}company${R} v${VERSION} - run Claude, Inc. from any terminal

USAGE
  company brief "<mission>"          Brief the CEO; routes to relevant departments
  company <dept> "<task>"            Task one department directly
  company roster                     Show the org chart
  company team                       Show the active team profile
  company onboard [--global]         Configure an optional active team profile
  company hire [--project]           Install skills+agents (~/.claude or ./.claude)
  company help                       This help

DEPARTMENTS (aliases)
  dev · design · marketing · social · finance · smb · legal · sales

OPTIONS
  -p, --print                        Print the composed prompt instead of running it
                                     (pipe it into ANY AI CLI: gemini, codex, llm, ...)

ENGINE
  Uses '\$CLAUDE_INC_ENGINE' (default: claude). Examples:
    company dev "fix my failing tests"
    company legal "triage this NDA: \$(cat nda.md)" --print | gemini
    CLAUDE_INC_ENGINE=codex company marketing "landing copy for my SaaS"
EOF
}

# ----------------------------------------------------------------------- main
[ $# -ge 1 ] || { usage; exit 1; }

PRINT_ONLY="no"
ARGS=()
for a in "$@"; do
  case "$a" in
    -p|--print) PRINT_ONLY="yes" ;;
    *) ARGS+=("$a") ;;
  esac
done
set -- "${ARGS[@]}"

CMD="$1"; shift || true

case "$CMD" in
  roster|org)     roster ;;
  team)           show_team ;;
  profile-context) profile_context ;;
  profile-save)    profile_save "$@" ;;
  onboard)        onboard "$@" ;;
  help|-h|--help) usage ;;
  version|-v)     out "company v${VERSION}" ;;
  hire|install)   exec bash "$ROOT/install.sh" "$@" ;;
  brief|ceo)
    [ $# -ge 1 ] || { echo "usage: company brief \"<mission>\"" >&2; exit 1; }
    PROMPT=""; COMPOSE_STATUS=0
    PROMPT="$(compose_brief "$*")" || COMPOSE_STATUS=$?
    [ "$COMPOSE_STATUS" -eq 0 ] || exit "$COMPOSE_STATUS"
    run_prompt "$PROMPT" "$PRINT_ONLY"
    ;;
  *)
    DEPT="$(dept_of "$CMD")"
    if [ -n "$DEPT" ]; then
      [ $# -ge 1 ] || { echo "usage: company $CMD \"<task>\"" >&2; exit 1; }
      PROMPT=""; COMPOSE_STATUS=0
      PROMPT="$(compose_dept "$DEPT" "$*")" || COMPOSE_STATUS=$?
      [ "$COMPOSE_STATUS" -eq 0 ] || exit "$COMPOSE_STATUS"
      run_prompt "$PROMPT" "$PRINT_ONLY"
    else
      echo "unknown command or department: $CMD" >&2
      echo "departments: dev · design · marketing · social · finance · smb · legal · sales" >&2
      exit 1
    fi
    ;;
esac
