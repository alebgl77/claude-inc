#!/usr/bin/env bash
# company — run Claude, Inc. from any terminal, with any AI CLI.
# https://github.com/alebgl77/claude-inc
set -euo pipefail

VERSION="1.1.0"

# ---------------------------------------------------------------- resolve root
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"

# ------------------------------------------------------------------- cosmetics
if [ -t 1 ]; then
  B=$'\033[1m'; DIM=$'\033[2m'; OR=$'\033[38;5;208m'; R=$'\033[0m'
else
  B=""; DIM=""; OR=""; R=""
fi

# ---------------------------------------------------------------- org registry
DEPTS=(developers designers marketing social-media finance small-business legal sales)

dept_of() { # alias -> canonical department
  case "$1" in
    dev|developers|engineering)      echo "developers" ;;
    design|designers)                echo "designers" ;;
    marketing|mkt|growth)            echo "marketing" ;;
    social|social-media|sm)          echo "social-media" ;;
    finance|fin|cfo)                 echo "finance" ;;
    smb|small-business|business|ops) echo "small-business" ;;
    legal|law|counsel)               echo "legal" ;;
    sales|sell|revenue|deals)        echo "sales" ;;
    *)                               echo "" ;;
  esac
}

skills_of() {
  case "$1" in
    developers)     echo "superpowers context7 mcp-builder skill-creator webapp-testing claude-mem" ;;
    designers)      echo "ui-ux-pro-max taste frontend-design transitions web-artifacts brand-guidelines" ;;
    marketing)      echo "copywriting ai-seo cro ad-creative customer-research lead-magnets" ;;
    social-media)   echo "post-writer profile-optimizer reels-scripting hook-generator voice-builder youtube-thumbnail" ;;
    finance)        echo "financial-statements journal-entry reconciliation variance-analysis audit-support close-management" ;;
    small-business) echo "cash-flow-snapshot invoice-chase plan-payroll margin-analyzer tax-prep run-campaign" ;;
    legal)          echo "review-contract triage-nda compliance-check legal-risk-assessment vendor-check signature-request" ;;
    sales)          echo "account-research draft-outreach call-prep proposal-builder objection-handler pipeline-review" ;;
  esac
}

# ------------------------------------------------------------------ composers
compose_dept() { # $1=dept $2=task -> full self-contained prompt on stdout
  local dept="$1" task="$2" s
  echo "# Claude, Inc. — ${dept} department"
  echo
  echo "You are the head of the ${dept} department. Your charter follows, then the full instruction manual of each employee (skill) on your team. Use them."
  echo
  echo "----- DEPARTMENT CHARTER -----"
  cat "$ROOT/agents/${dept}.md"
  for s in $(skills_of "$dept"); do
    echo
    echo "----- EMPLOYEE: ${s} -----"
    cat "$ROOT/skills/${s}/SKILL.md"
  done
  echo
  echo "----- TASK FROM THE CEO -----"
  echo "$task"
  echo
  echo "Pick the right employee(s) above, execute their workflow, deliver files where appropriate, and report in your department memo format."
}

compose_brief() { # $1=mission
  local mission="$1"
  cat "$ROOT/CLAUDE.md"
  local s
  for s in chief-of-staff token-accountant; do
    if [ -f "$ROOT/skills/${s}/SKILL.md" ]; then
      echo
      echo "----- CEO STAFF: ${s} -----"
      cat "$ROOT/skills/${s}/SKILL.md"
    fi
  done
  echo
  echo "----- NOTE -----"
  echo "If your environment has no subagent/Task tool, simulate the departments sequentially yourself: for each relevant department, adopt its charter and skills (in agents/ and skills/), do the work, then produce the final Board Memo."
  echo
  echo "----- MISSION FROM THE FOUNDER -----"
  echo "$mission"
}

# --------------------------------------------------------------------- runner
ENGINE="${CLAUDE_INC_ENGINE:-claude}"

run_prompt() { # $1=prompt $2=print_only
  local prompt="$1" print_only="$2"
  if [ "$print_only" = "yes" ]; then
    printf '%s\n' "$prompt"
  elif command -v "$ENGINE" >/dev/null 2>&1; then
    exec "$ENGINE" "$prompt"
  else
    echo "${DIM}engine '$ENGINE' not found — printing prompt (pipe it into any AI CLI, or set CLAUDE_INC_ENGINE)${R}" >&2
    printf '%s\n' "$prompt"
  fi
}

# --------------------------------------------------------------------- roster
roster() {
  echo "${OR}${B}Claude, Inc.${R} ${DIM}· 1 CEO · 8 departments · 50 employees (founding 42 + Series A)${R}"
  echo
  echo "                        ${B}CEO${R} ${DIM}(your AI CLI)${R}"
  echo "  ┌──────────┬──────────┬─────┴─────┬──────────┬──────────┬──────────┐"
  local d
  for d in "${DEPTS[@]}"; do
    printf '  %s%-15s%s %s\n' "$B" "$d" "$R" "$(skills_of "$d" | sed 's/ / · /g')"
  done
  printf '  %s%-15s%s %s\n' "$DIM" "staff (CEO)" "$R" "chief-of-staff · token-accountant"
  echo
  echo "  ${DIM}company brief \"<mission>\"    → CEO routes across departments${R}"
  echo "  ${DIM}company <dept> \"<task>\"      → talk to one department directly${R}"
}

usage() {
  cat <<EOF
${OR}${B}company${R} v${VERSION} — run Claude, Inc. from any terminal

USAGE
  company brief "<mission>"          Brief the CEO; routes across all departments
  company <dept> "<task>"            Task one department directly
  company roster                     Show the org chart
  company hire [--project]           Install skills+agents (~/.claude or ./.claude)
  company help                       This help

DEPARTMENTS (aliases)
  dev · design · marketing · social · finance · smb · legal · sales

OPTIONS
  -p, --print                        Print the composed prompt instead of running it
                                     (pipe it into ANY AI CLI: gemini, codex, llm, ...)

ENGINE
  Uses '\$CLAUDE_INC_ENGINE' (default: claude). Examples:
    company dev "fix my failing tests"
    company legal "triage this NDA: \$(cat nda.md)" --print | gemini
    CLAUDE_INC_ENGINE=codex company marketing "landing copy for my SaaS"
EOF
}

# ----------------------------------------------------------------------- main
[ $# -ge 1 ] || { usage; exit 1; }

PRINT_ONLY="no"
ARGS=()
for a in "$@"; do
  case "$a" in
    -p|--print) PRINT_ONLY="yes" ;;
    *) ARGS+=("$a") ;;
  esac
done
set -- "${ARGS[@]}"

CMD="$1"; shift || true

case "$CMD" in
  roster|org)     roster ;;
  help|-h|--help) usage ;;
  version|-v)     echo "company v${VERSION}" ;;
  hire|install)   exec bash "$ROOT/install.sh" "$@" ;;
  brief|ceo)
    [ $# -ge 1 ] || { echo "usage: company brief \"<mission>\"" >&2; exit 1; }
    run_prompt "$(compose_brief "$*")" "$PRINT_ONLY"
    ;;
  *)
    DEPT="$(dept_of "$CMD")"
    if [ -n "$DEPT" ]; then
      [ $# -ge 1 ] || { echo "usage: company $CMD \"<task>\"" >&2; exit 1; }
      run_prompt "$(compose_dept "$DEPT" "$*")" "$PRINT_ONLY"
    else
      echo "unknown command or department: $CMD" >&2
      echo "departments: dev · design · marketing · social · finance · smb · legal" >&2
      exit 1
    fi
    ;;
esac
